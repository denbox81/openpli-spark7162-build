name: Check Spark7162 Sources

on:
  workflow_dispatch:
  push:
    branches:
      - main

jobs:
  check:
    runs-on: ubuntu-22.04

    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Check OpenPLi source
        run: |
          git ls-remote https://github.com/OpenPLi/openpli-oe-core.git HEAD

      - name: Check pli-extras
        run: |
          git ls-remote https://github.com/PLi-metas/pli-extras.git HEAD

      - name: Finish
        run: echo "Spark7162 source check completed"
